// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma.config.ts (Prisma 7+)
  // url = env("DATABASE_URL")
}

// ── Cards ────────────────────────────────────────────────────────────
// Each journal entry is a "card" with a coding problem or concept,
// plus SM-2 spaced-repetition fields for review scheduling.

model Card {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())       @map("created_at")
  updatedAt    DateTime @updatedAt            @map("updated_at")

  question     String                         @db.VarChar(500)
  link         String   @default("")          @db.VarChar(1000)
  difficulty   String   @default("medium")    @db.VarChar(10)   // easy | medium | hard

  actualCode   String   @default("")          @db.Text @map("actual_code")
  myThinking   String   @default("")          @db.Text @map("my_thinking")
  rightThinking String  @default("")          @db.Text @map("right_thinking")
  notes        String   @default("")          @db.Text

  // SM-2 spaced-repetition algorithm fields (flattened from the sm2 object)
  easinessFactor Float?  @default(2.5)        @map("easiness_factor")
  interval       Int?    @default(0)
  repetitions    Int?    @default(0)
  nextReview     DateTime?                    @map("next_review")
  lastReview     DateTime?                    @map("last_review")
  lastQuality    Int?                         @map("last_quality")  // 0–5

  tags CardTag[]

  @@map("cards")
}

// ── Tags ─────────────────────────────────────────────────────────────
// Normalised tag table — each tag can be attached to many cards.

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique                       @db.VarChar(50)
  cards CardTag[]

  @@map("tags")
}

// ── Card ↔ Tag junction ──────────────────────────────────────────────
// Many-to-many relationship between cards and tags.

model CardTag {
  cardId String                     @map("card_id")
  tagId  String                     @map("tag_id")
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@map("cards_tags")
}