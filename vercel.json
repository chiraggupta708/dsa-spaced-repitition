{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/*.js": {
      "runtime": "nodejs@20.x"
    }
  },
  "rewrites": [
    { "source": "/api/cards/:cardId/review", "destination": "/api/cards/:cardId?review=1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
