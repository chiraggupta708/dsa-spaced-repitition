# ── Prisma / Postgres ─────────────────────────────────────────────────
# Connection string for the Vercel Postgres (Neon) database.
# Replace with the connection string from your Vercel dashboard.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Optional: Direct Neon connection string (used by @neondatabase/serverless)
# Same as DATABASE_URL but with connection pooling suffix if needed.
# Usually the same as DATABASE_URL.

# ── Optional: LLD interviewer provider ────────────────────────────────
# Keep the OpenRouter credential in the local secret manager or shell;
# never commit it to this file or send it to the browser.
LLD_AI_PROVIDER="openrouter"
LLD_AI_MODEL="deepseek/deepseek-v4-flash-0731"
# OPENROUTER_API_KEY=""

POSTGRES_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"